generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String                 @id @default(uuid())
  email          String                 @unique
  createdAt      DateTime               @default(now())
  isAdmin        Boolean                @default(false)
  transactions   Transaction[]
  vehicles       Vehicle[]
  budgets        Budget[]
  recurring      RecurringTransaction[]
  alerts         Alert[]
  indiaTransfers IndiaTransfer[]
  chitFunds      ChitFund[]
  chitFundPlans  ChitFundPlan[]
  loansGiven     LoanGiven[]
  preferences    Json?
}

/** A purely informational log of money sent to family in India — never counted in income/expense totals, budgets, or any chart; just notes the user wants to keep track of separately. */
model IndiaTransfer {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  recipient String
  notes     String?
  date      DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([date])
}

/** Monthly chit fund ("Cheeti") contributions — purely informational savings tracking, never counted in income/expense totals. A user can belong to multiple chits, distinguished by groupName. type "paid" (default) is money going out to a chit and rolls into Total Saved; "received" is incoming money (e.g. interest on a loan given out) and is tracked separately as Total Received. */
model ChitFund {
  id        String   @id @default(uuid())
  userId    String
  groupName String
  amount    Float
  type      String   @default("paid") // "paid" | "received"
  notes     String?
  date      DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([date])
}

/** A private loan given to someone, at a monthly interest rate — tracks Outstanding Amount (principal plus any interest accrued since startDate that hasn't yet shown up as a "received" ChitFund entry for the same borrowerName). Purely informational, like the rest of Cheeti. */
model LoanGiven {
  id                  String   @id @default(uuid())
  userId              String
  borrowerName        String
  principal           Float
  interestRatePercent Float // percent per month, e.g. 1 = 1%/month
  startDate           DateTime
  notes               String?
  isActive            Boolean  @default(true) // false = closed/fully repaid
  createdAt           DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

/** A recurring Cheeti contribution set up once (start date + total period in months) — the daily cron auto-creates a ChitFund row each month it's due, so the user doesn't have to log every payment by hand. Deactivates itself once periodMonths payments have posted. */
model ChitFundPlan {
  id           String    @id @default(uuid())
  userId       String
  groupName    String
  amount       Float
  type         String    @default("paid") // "paid" | "received"
  startDate    DateTime
  periodMonths Int
  nextDueDate  DateTime
  monthsPosted Int       @default(0)
  isActive     Boolean   @default(true)
  lastCreated  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Budget {
  id        String   @id @default(uuid())
  userId    String
  category  String
  amount    Float
  month     Int // 1-12
  year      Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, category, month, year])
}

model RecurringTransaction {
  id          String    @id @default(uuid())
  userId      String
  title       String
  amount      Float
  type        String // "income" | "expense"
  category    String
  frequency   String // "weekly" | "biweekly" | "monthly" | "yearly"
  startDate   DateTime
  nextDueDate DateTime
  lastCreated DateTime?
  isActive    Boolean   @default(true)
  notes       String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Alert {
  id        String   @id @default(uuid())
  userId    String
  type      String // "budget_exceeded" | "budget_warning" | "maintenance_due" | "insurance_due" | "oil_change_due" | "recurring_due" | "mpg_drop" | "fuel_price_spike"
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, isRead])
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  title     String
  amount    Float
  type      String // "income" | "expense"
  category  String
  scope     String   @default("life") // "life" | "vehicle" — which tracking-mode bucket this belongs to
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([date])
  @@index([userId, scope])
}

model Vehicle {
  id              String           @id @default(uuid())
  userId          String
  nickname        String
  make            String
  model           String
  year            Int
  color           String
  licensePlate    String?
  photoUrl        String?
  purchasePrice   Float?
  purchaseDate    DateTime?
  startOdometer   Float?
  isActive        Boolean          @default(true)
  isPrimary       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id])
  fuelLogs        FuelLog[]
  maintenanceLogs MaintenanceLog[]
  repairLogs      RepairLog[]
  odometerLogs    OdometerLog[]
  dailyOdometers  DailyOdometer[]
  insurance       Insurance[]

  @@index([userId])
}

model FuelLog {
  id             String   @id @default(uuid())
  vehicleId      String
  date           DateTime
  gallons        Float
  pricePerGallon Float
  totalCost      Float
  odometer       Float
  station        String?
  notes          String?
  type           String   @default("per_fill") // "per_fill" | "weekly_summary"
  isFullTank     Boolean  @default(true) // false = partial top-off; its gallons roll into the next full-tank MPG segment instead of standing alone
  createdAt      DateTime @default(now())
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([date])
}

model MaintenanceLog {
  id           String    @id @default(uuid())
  vehicleId    String
  date         DateTime
  type         String // "Oil Change" | "Tire Rotation" | "Air Filter" | "Brake Pad" | "Battery" | "Wiper Blades" | "Other"
  cost         Float
  odometer     Float
  shop         String?
  notes        String?
  nextDueDate  DateTime?
  nextDueMiles Float?
  createdAt    DateTime  @default(now())
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([date])
}

model RepairLog {
  id          String   @id @default(uuid())
  vehicleId   String
  date        DateTime
  description String
  cost        Float
  odometer    Float
  shop        String?
  partsCost   Float?
  laborCost   Float?
  notes       String?
  createdAt   DateTime @default(now())
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([date])
}

model OdometerLog {
  id        String   @id @default(uuid())
  vehicleId String
  date      DateTime
  miles     Float
  notes     String?
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([date])
}

/**
 * One-per-day odometer log (Part B daily tracking) — a stricter, separate model from OdometerLog.
 */
model DailyOdometer {
  id        String   @id @default(uuid())
  vehicleId String
  date      DateTime @db.Date
  miles     Float
  driven    Float
  notes     String?
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, date])
}

model Insurance {
  id           String   @id @default(uuid())
  vehicleId    String
  provider     String
  policyNumber String?
  monthlyCost  Float
  startDate    DateTime
  renewalDate  DateTime
  coverageType String // "Liability" | "Comprehensive" | "Full Coverage"
  notes        String?
  createdAt    DateTime @default(now())
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
}
