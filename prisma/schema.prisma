generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String                 @id @default(uuid())
  email        String                 @unique
  createdAt    DateTime               @default(now())
  isAdmin      Boolean                @default(false)
  transactions Transaction[]
  vehicles     Vehicle[]
  budgets      Budget[]
  recurring    RecurringTransaction[]
  alerts       Alert[]
  preferences  Json?
}

model Budget {
  id        String   @id @default(uuid())
  userId    String
  category  String
  amount    Float
  month     Int // 1-12
  year      Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, category, month, year])
}

model RecurringTransaction {
  id          String    @id @default(uuid())
  userId      String
  title       String
  amount      Float
  type        String // "income" | "expense"
  category    String
  frequency   String // "weekly" | "biweekly" | "monthly" | "yearly"
  startDate   DateTime
  nextDueDate DateTime
  lastCreated DateTime?
  isActive    Boolean   @default(true)
  notes       String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Alert {
  id        String   @id @default(uuid())
  userId    String
  type      String // "budget_exceeded" | "budget_warning" | "maintenance_due" | "insurance_due" | "oil_change_due" | "recurring_due" | "mpg_drop" | "fuel_price_spike"
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, isRead])
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  title     String
  amount    Float
  type      String // "income" | "expense"
  category  String
  scope     String   @default("life") // "life" | "vehicle" — which tracking-mode bucket this belongs to
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([date])
  @@index([userId, scope])
}

model Vehicle {
  id              String           @id @default(uuid())
  userId          String
  nickname        String
  make            String
  model           String
  year            Int
  color           String
  licensePlate    String?
  photoUrl        String?
  purchasePrice   Float?
  purchaseDate    DateTime?
  startOdometer   Float?
  isActive        Boolean          @default(true)
  isPrimary       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id])
  fuelLogs        FuelLog[]
  maintenanceLogs MaintenanceLog[]
  repairLogs      RepairLog[]
  odometerLogs    OdometerLog[]
  dailyOdometers  DailyOdometer[]
  insurance       Insurance[]

  @@index([userId])
}

model FuelLog {
  id             String   @id @default(uuid())
  vehicleId      String
  date           DateTime
  gallons        Float
  pricePerGallon Float
  totalCost      Float
  odometer       Float
  station        String?
  notes          String?
  type           String   @default("per_fill") // "per_fill" | "weekly_summary"
  createdAt      DateTime @default(now())
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([date])
}

model MaintenanceLog {
  id           String    @id @default(uuid())
  vehicleId    String
  date         DateTime
  type         String // "Oil Change" | "Tire Rotation" | "Air Filter" | "Brake Pad" | "Battery" | "Wiper Blades" | "Other"
  cost         Float
  odometer     Float
  shop         String?
  notes        String?
  nextDueDate  DateTime?
  nextDueMiles Float?
  createdAt    DateTime  @default(now())
  vehicle      Vehicle   @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([date])
}

model RepairLog {
  id          String   @id @default(uuid())
  vehicleId   String
  date        DateTime
  description String
  cost        Float
  odometer    Float
  shop        String?
  partsCost   Float?
  laborCost   Float?
  notes       String?
  createdAt   DateTime @default(now())
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([date])
}

model OdometerLog {
  id        String   @id @default(uuid())
  vehicleId String
  date      DateTime
  miles     Float
  notes     String?
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([date])
}

/**
 * One-per-day odometer log (Part B daily tracking) — a stricter, separate model from OdometerLog.
 */
model DailyOdometer {
  id        String   @id @default(uuid())
  vehicleId String
  date      DateTime @db.Date
  miles     Float
  driven    Float
  notes     String?
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, date])
}

model Insurance {
  id           String   @id @default(uuid())
  vehicleId    String
  provider     String
  policyNumber String?
  monthlyCost  Float
  startDate    DateTime
  renewalDate  DateTime
  coverageType String // "Liability" | "Comprehensive" | "Full Coverage"
  notes        String?
  createdAt    DateTime @default(now())
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
}
